# ── Client-side (Supabase — safe to expose, RLS enforces security) ──────────
# Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Server-side only (Vercel environment variables — NEVER prefix with VITE_) ─
# These are used exclusively by the /api proxy functions and are never sent
# to the browser or included in the client JS bundle.

# Supabase service role key — allows the proxy to write to the shared quotes
# cache table (bypasses RLS). Keep this secret.
# Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Alpha Vantage — primary quote source (25 req/min free)
# https://www.alphavantage.co/support/#api-key
AV_KEY=your_alpha_vantage_key_here

# Finnhub — automatic fallback when Alpha Vantage is rate-limited (60 req/min free)
# https://finnhub.io/register
FH_KEY=your_finnhub_key_here

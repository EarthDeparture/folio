# Supabase (new project)
# Dashboard -> Project Settings -> API: Project URL and anon public key
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Alpha Vantage API Key (primary quote source)
# Get your free key from: https://www.alphavantage.co/support/#api-key
VITE_AV_KEY=your_alpha_vantage_key_here

# Finnhub API Key (fallback — used automatically when Alpha Vantage rate limits are hit)
# Get your free key from: https://finnhub.io/register (60 req/min, no credit card)
VITE_FH_KEY=your_finnhub_key_here
